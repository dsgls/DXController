# Every text file is LF in the tree (this overrides core.autocrlf). UCC.exe
# wants CRLF; the build scripts convert on the way into the game dir.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.bmp binary
*.u binary
